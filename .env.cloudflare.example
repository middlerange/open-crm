# Copy to .env.cloudflare (ignored). Existing Cloudflare secrets are retained.
ORBIT_WORKER_NAME=orbit-gtm
# Optional: omit for the assigned workers.dev address.
APP_ORIGIN=
ORBIT_CUSTOM_DOMAINS=
ORBIT_REDIRECT_ORIGINS=
# Optional Hyperdrive; otherwise set DATABASE_URL below.
ORBIT_HYPERDRIVE_ID=
DATABASE_URL=
DATABASE_SSL=require
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
# Optional Userorbit widget; leave empty to disable. When set, signed-in user and workspace details are sent to Userorbit.
USERORBIT_ACCOUNT_ID=
USERORBIT_API_HOST=https://api.userorbit.com
SESSION_COOKIE_NAME=orbit_session
# Comma-separated Chrome extension IDs allowed to sign in; required for the extension.
ORBIT_EXTENSION_IDS=
# Optional email: configure your verified Cloudflare domain before enabling.
ORBIT_EMAIL_BINDING=false
MAIL_DOMAINS=
MAIL_DOMAIN_WORKSPACES={}
MAIL_INBOUND_ALIASES={}
MAIL_SENDING_ENABLED=false
