{
  "manifest_version": 3,
  "name": "Orbit LinkedIn Lead Collector",
  "version": "0.2.0",
  "description": "Collect reactions and comments from LinkedIn posts into Orbit for manual qualification.",
  "permissions": ["activeTab", "identity", "sidePanel", "storage"],
  "host_permissions": ["https://www.linkedin.com/*", "http://localhost:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Orbit lead collector"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "css": ["content.css"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["orbit-mark.svg"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
