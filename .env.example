NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:8787
ORBIT_EXTENSION_API_ORIGIN=http://localhost:8787
DATABASE_URL=postgres://user:password@your-managed-postgres-host/database?sslmode=require
SESSION_COOKIE_NAME=orbit_session
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=
ORBIT_API_URL=http://localhost:8787
ORBIT_API_KEY=replace-with-a-provisioned-agent-key

# Onboard these domains in Cloudflare Email Service before enabling sending.
MAIL_DOMAINS=
MAIL_DOMAIN_WORKSPACES={}
# Optional one-hop mappings from trusted routing addresses to Orbit mailboxes.
MAIL_INBOUND_ALIASES={}
MAIL_SENDING_ENABLED=false
# Node deployments use REST; Workers use the MAILER binding.
# CLOUDFLARE_EMAIL_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
# Node inbound bridge only: random secret with at least 32 characters.
# MAIL_INGRESS_SECRET=

DATABASE_SSL=require
USERORBIT_ACCOUNT_ID=
USERORBIT_API_HOST=https://api.userorbit.com
POSTGRES_PASSWORD=
